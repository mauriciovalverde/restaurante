# Token de acesso do Instagram (API do Instagram com login do Instagram).
# Precisa das permissões: instagram_business_basic e instagram_business_manage_messages.
INSTAGRAM_ACCESS_TOKEN=

# Versão da Graph API
GRAPH_API_VERSION=v23.0

# Porta do servidor
PORT=3000

# Intervalo (ms) entre mensagens no envio em massa, para respeitar limites da API
SEND_DELAY_MS=1500

# true = usa contatos fictícios e não envia nada de verdade (bom para testar a interface)
DEMO_MODE=false
